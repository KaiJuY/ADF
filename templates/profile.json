{
  "baseBranch": "main",
  "solution": "<Name>.sln",
  "mainFramework": "net8.0",
  "releaseFrameworks": ["net8.0"],
  "testProjects": [
    "tests/<Name>.Tests/<Name>.Tests.csproj",
    { "path": "tests/<Name>.Wpf.Tests/<Name>.Wpf.Tests.csproj", "frameworks": ["net8.0-windows"] }
  ],
  "sourceProjects": [
    "src/<Name>/<Name>.csproj"
  ],
  "exclude": [
    "**/obj/**",
    "**/bin/**",
    "**/*.g.cs",
    "**/*.g.i.cs",
    "**/*.Designer.cs"
  ],
  "limits": {
    "crap": 12,
    "complexity": 12,
    "changedLineCoverage": 0.9
  }
}
